<?xml version="1.0" encoding="UTF-8"?>
<!-- Samsung Tizen TV. الإصدار يُحدَّث من package.json عند الحزم (scripts/package.mjs). -->
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://ssouq.net/player" version="1.0.0" viewmodes="maximized">
    <tizen:application id="SsouqNetPl.Player" package="SsouqNetPl" required_version="3.0"/>
    <tizen:profile name="tv-samsung"/>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <name>Ssouq Net</name>
    <description>مشغّل وسائط لقوائم IPTV (Xtream Codes وM3U). لا يحتوي على أي محتوى.</description>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <!-- التطبيق يتصل بخادم المزوّد (أي أصل) وبـ /api/v1/player في المنصة. -->
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
