# ---- قاعدة البيانات (PostgreSQL) ----
# محلياً: docker compose up -d ثم استخدم الرابط التالي.
# على Coolify: رابط الاتصال الداخلي لمورد PostgreSQL.
DATABASE_URL=postgresql://commerce:commerce@localhost:5432/commerce

# ---- المصادقة (Better Auth) ----
# ولّد سراً: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-chars-min

# ---- التطبيق ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# الدومين الرئيسي للمنصة بدون بروتوكول. المتاجر على subdomains تحته.
PLATFORM_DOMAIN=localhost:3000

# ---- التخزين (S3-compatible: MinIO على Coolify أو Cloudflare R2) ----
S3_ENDPOINT=https://minio.example.com
S3_REGION=auto
S3_BUCKET=commerce
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://minio.example.com/commerce
