# ---- قاعدة البيانات (PostgreSQL) ----
# محلياً: docker compose up -d ثم استخدم الرابط التالي.
# على Coolify: رابط الاتصال الداخلي لمورد PostgreSQL (postgresql://user:pass@host:5432/db).
DATABASE_URL=postgresql://commerce:commerce@localhost:5432/commerce

# ---- Supabase (Auth / Storage فقط) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- التطبيق ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
